# ── Dependencies ──────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────
dist/
dist-ssr/

# ── Environment variables (NEVER commit secrets) ──────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# ── Vite cache ────────────────────────────────────────────
.vite/

# ── Editor / IDE ──────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS metadata ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Package manager locks (keep whichever you use) ────────
# Uncomment to exclude the lock file you do NOT use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ── Test / coverage ───────────────────────────────────────
coverage/
.nyc_output/

# ── Vercel ────────────────────────────────────────────────
.vercel/

# ── Misc ──────────────────────────────────────────────────
*.local
